{
  "name": "listmaster-backend",
  "version": "1.0.0",
  "description": "Backend API server for ListMaster Sample Management",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node ../scripts/clean-removed-excel.cjs",
    "test": "node ../scripts/test-regressions.cjs",
    "dev": "tsx watch src/main.ts",
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "node -e \"require('fs').cpSync('src/infrastructure/database/migrations', 'dist/infrastructure/database/migrations', {recursive: true})\"",
    "start": "node dist/main.js",
    "init-admin": "tsx src/scripts/init-admin.ts",
    "prestart": "node ../scripts/check-runtime.cjs"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "pino": "9.14.0",
    "pino-pretty": "13.2.0",
    "socket.io": "4.8.4",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.5",
    "@types/uuid": "10.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  }
}
